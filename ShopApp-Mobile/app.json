{
  "expo": {
    "name": "CE Shop",
    "slug": "courier-express-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.courierexpress.shop",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng dùng camera để quét mã vận đơn và chụp ảnh đính kèm khiếu nại.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để đính kèm ảnh vào khiếu nại.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true }
      }
    },
    "android": {
      "package": "com.courierexpress.shop",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": ["CAMERA", "VIBRATE"]
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Ứng dụng dùng camera để quét mã vận đơn và chụp ảnh đính kèm khiếu nại." }],
      ["expo-image-picker", {
        "cameraPermission": "Ứng dụng dùng camera để chụp ảnh đính kèm khiếu nại.",
        "photosPermission": "Ứng dụng cần truy cập thư viện ảnh để đính kèm ảnh vào khiếu nại."
      }],
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "extra": {
      "defaultServerUrl": "http://192.168.1.10:5180"
    }
  }
}
